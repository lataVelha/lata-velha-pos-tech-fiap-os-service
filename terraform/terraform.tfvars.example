# Copie para terraform.tfvars (não versionado) e preencha.
# As variáveis cluster_* e docker_image são injetadas automaticamente pelo
# apply.sh/workflow — não coloque valores reais aqui.

region       = "us-east-1"
state_bucket = "lata-velha-tfstate-<account-id>"
cluster_name = "lata-velha-eks"
node_port    = 30082

# RDS proprio do os-service (database-per-service; nao usa mais o infra-db).
db_name            = "lata_velha_os"
db_username        = "lata_velha_os_user"
rds_instance_class = "db.t3.micro"

# Obrigatórias: o pod entra em CrashLoopBackOff sem SMTP autenticado.
mail_username = "seu-email@gmail.com"
mail_password = "sua-app-password"

# Opcional: Datadog OTLP ingest
dd_api_key = ""
